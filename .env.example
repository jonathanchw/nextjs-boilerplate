# Required for automated post generation (generatePost.js / GitHub Actions)
GEMINI_API_KEY=

# Optional: primary and fallback Gemini models (same API key)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Retry / timeout tuning for transient Gemini errors (503, 429, 5xx, network)
GEMINI_MAX_RETRIES=4
GEMINI_RETRY_BASE_MS=1000
GEMINI_RETRY_MAX_MS=30000
GEMINI_REQUEST_DEADLINE_MS=120000

# Optional backup provider when Gemini stays unavailable (uses existing openai dependency)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PEXELS_API_KEY=
SITE_URL=

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
